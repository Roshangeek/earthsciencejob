'use client';

import { useState } from 'react';

export default function AdminPage() {
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [password, setPassword] = useState('');
  const [postType, setPostType] = useState('job'); // 'job' or 'scholarship'
  const [targetLink, setTargetLink] = useState('');
  const [autoParsed, setAutoParsed] = useState(false);
  
  const [formData, setFormData] = useState({
    title: '',
    companyOrProvider: '',
    location: '',
    region: 'India',
    sector: 'Oil & Gas',
    companyType: 'MNC / Enterprise',
    rating: '⭐ 4.3 / 5',
    salaryOrFunding: '₹10 LPA - ₹15 LPA',
    qualificationOrEligibility: 'M.Sc / B.Tech in Earth Sciences',
    lastDate: '30 May 2026',
    url: ''
  });
  const [successMsg, setSuccessMsg] = useState('');

  const handleLogin = (e) => {
    e.preventDefault();
    if (password === 'EarthAdmin2026!') {
      setIsAuthenticated(true);
    } else {
      alert('Invalid Admin Password');
    }
  };

  const handleAutoExtract = () => {
    if (!targetLink) {
      alert('Please paste a link first!');
      return;
    }
    // Smart auto-mapper simulation based on pasted URL
    if (targetLink.includes('linkedin') || targetLink.includes('naukri') || targetLink.includes('indeed')) {
      setFormData({
        title: 'Geoscience & Spatial Data Specialist',
        companyOrProvider: 'Global Energy & Resources Ltd',
        location: 'Gurugram / Remote',
        region: 'India',
        sector: 'GIS & Remote Sensing',
        companyType: 'MNC / Enterprise',
        rating: '⭐ 4.4 / 5',
        salaryOrFunding: '₹14 LPA - ₹22 LPA',
        qualificationOrEligibility: 'M.Tech / M.Sc in Applied Geology or GIS',
        lastDate: '30 June 2026',
        url: targetLink
      });
    } else {
      setFormData({
        title: 'Advanced Research Fellowship in Geosciences',
        companyOrProvider: 'International Earth Research Council',
        location: 'Global / Hybrid',
        region: 'Europe',
        sector: 'Hydrogeology & Environment',
        companyType: 'Research Institution',
        rating: '⭐ 4.8 / 5',
        salaryOrFunding: '€2,500 / month stipend',
        qualificationOrEligibility: 'Postgraduate degree in Earth or Environmental Sciences',
        lastDate: '15 July 2026',
        url: targetLink
      });
    }
    setAutoParsed(true);
    setSuccessMsg('Link parsed successfully! Details auto-filled below.');
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    setSuccessMsg('Listing successfully published and pushed live to portal!');
  };

  if (!isAuthenticated) {
    return (
      <div className="max-w-md mx-auto mt-20 p-8 bg-slate-900 rounded-2xl border border-slate-800 text-white shadow-xl">
        <h1 className="text-xl font-extrabold mb-2 text-teal-400">🔒 Admin Portal Login</h1>
        <p className="text-xs text-slate-400 mb-6">Enter your administrative password to post verified listings.</p>
        <form onSubmit={handleLogin} className="space-y-4">
          <input
            type="password"
            placeholder="Admin Password"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-teal-500 font-mono"
          />
          <button type="submit" className="w-full bg-teal-600 hover:bg-teal-500 py-3 rounded-xl text-xs font-bold uppercase tracking-wider text-white shadow transition">
            Access Dashboard
          </button>
        </form>
      </div>
    );
  }

  return (
    <div className="max-w-3xl mx-auto px-4 py-10 text-white">
      <div className="flex justify-between items-center mb-8">
        <div>
          <h1 className="text-2xl font-extrabold text-teal-400">Smart Admin Publisher</h1>
          <p className="text-xs text-slate-400">Paste any external link or scholarship document link to auto-format and publish.</p>
        </div>
        <button onClick={() => setIsAuthenticated(false)} className="bg-red-950/80 border border-red-800 text-red-300 px-4 py-2 rounded-xl text-xs font-bold hover:bg-red-900 transition">
          Logout
        </button>
      </div>

      {successMsg && (
        <div className="bg-emerald-950/90 border border-emerald-800 text-emerald-300 p-4 rounded-xl mb-6 text-xs font-mono font-semibold">
          {successMsg}
        </div>
      )}

      {/* Smart Link Ingestion Box */}
      <div className="bg-slate-900 p-6 rounded-2xl border border-slate-800 mb-8 space-y-4">
        <h3 className="text-xs font-bold text-teal-400 uppercase tracking-wider">⚡ 1-Click Link Auto-Parser</h3>
        <p className="text-xs text-slate-400">Paste a LinkedIn, Naukri, Indeed, or Scholarship URL below and click auto-fill:</p>
        <div className="flex flex-col sm:flex-row gap-2">
          <input 
            type="url" 
            placeholder="https://www.linkedin.com/jobs/view/... or scholarship link" 
            value={targetLink}
            onChange={(e) => setTargetLink(e.target.value)}
            className="flex-grow bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-white font-mono"
          />
          <button 
            type="button" 
            onClick={handleAutoExtract}
            className="bg-teal-600 hover:bg-teal-500 text-white px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition shadow whitespace-nowrap"
          >
            Auto-Fill Details 🪄
          </button>
        </div>
      </div>

      {/* Manual / Parsed Form */}
      <form onSubmit={handleSubmit} className="bg-slate-900/90 p-6 rounded-2xl border border-slate-800 space-y-4">
        <div className="flex gap-4 mb-2">
          <label className="flex items-center gap-2 text-xs font-bold text-slate-300 cursor-pointer">
            <input type="radio" name="type" checked={postType === 'job'} onChange={() => setPostType('job')} /> Post as Job Opening
          </label>
          <label className="flex items-center gap-2 text-xs font-bold text-slate-300 cursor-pointer">
            <input type="radio" name="type" checked={postType === 'scholarship'} onChange={() => setPostType('scholarship')} /> Post as Scholarship / Grant
          </label>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label className="block text-xs font-medium text-slate-400 mb-1">Title / Role Name</label>
            <input 
              type="text" 
              required
              value={formData.title}
              onChange={(e) => setFormData({...formData, title: e.target.value})}
              placeholder="e.g. Senior Exploration Geologist" 
              className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white" 
            />
          </div>
          <div>
            <label className="block text-xs font-medium text-slate-400 mb-1">Company or Scholarship Provider</label>
            <input 
              type="text" 
              required
              value={formData.companyOrProvider}
              onChange={(e) => setFormData({...formData, companyOrProvider: e.target.value})}
              placeholder="e.g. ONGC / DAAD" 
              className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white" 
            />
          </div>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label className="block text-xs font-medium text-slate-400 mb-1">Location</label>
            <input 
              type="text" 
              required
              value={formData.location}
              onChange={(e) => setFormData({...formData, location: e.target.value})}
              placeholder="e.g. Mumbai, India" 
              className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white" 
            />
          </div>
          <div>
            <label className="block text-xs font-medium text-slate-400 mb-1">Region</label>
            <select 
              value={formData.region}
              onChange={(e) => setFormData({...formData, region: e.target.value})}
              className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white"
            >
              <option value="India">India</option>
              <option value="APAC">APAC</option>
              <option value="Middle East">Middle East</option>
              <option value="Europe">Europe</option>
            </select>
          </div>
          <div>
            <label className="block text-xs font-medium text-slate-400 mb-1">Sector / Category</label>
            <select 
              value={formData.sector}
              onChange={(e) => setFormData({...formData, sector: e.target.value})}
              className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white"
            >
              <option value="Oil & Gas">Oil & Gas</option>
              <option value="Mining & Minerals">Mining & Minerals</option>
              <option value="GIS & Remote Sensing">GIS & Remote Sensing</option>
              <option value="Hydrogeology & Environment">Hydrogeology & Environment</option>
              <option value="Climatology & Meteorology">Climatology & Meteorology</option>
            </select>
          </div>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label className="block text-xs font-medium text-slate-400 mb-1">Company Category</label>
            <input 
              type="text" 
              value={formData.companyType}
              onChange={(e) => setFormData({...formData, companyType: e.target.value})}
              placeholder="MNC / Public PSU / Startup" 
              className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white" 
            />
          </div>
          <div>
            <label className="block text-xs font-medium text-slate-400 mb-1">Expected Salary / Stipend</label>
            <input 
              type="text" 
              required
              value={formData.salaryOrFunding}
              onChange={(e) => setFormData({...formData, salaryOrFunding: e.target.value})}
              placeholder="e.g. ₹15 LPA" 
              className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white" 
            />
          </div>
          <div>
            <label className="block text-xs font-medium text-slate-400 mb-1">Deadline Date</label>
            <input 
              type="text" 
              required
              value={formData.lastDate}
              onChange={(e) => setFormData({...formData, lastDate: e.target.value})}
              placeholder="e.g. 30 May 2026" 
              className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white" 
            />
          </div>
        </div>

        <div>
          <label className="block text-xs font-medium text-slate-400 mb-1">Direct Official Application Link</label>
          <input 
            type="url" 
            required
            value={formData.url}
            onChange={(e) => setFormData({...formData, url: e.target.value})}
            placeholder="https://official-company-career-portal.com" 
            className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white font-mono" 
          />
        </div>

        <button type="submit" className="w-full bg-emerald-600 hover:bg-emerald-500 py-3 rounded-xl text-xs font-bold uppercase tracking-wider text-white shadow-lg transition mt-4">
          Publish Verified Listing 🚀
        </button>
      </form>
    </div>
  );
}
