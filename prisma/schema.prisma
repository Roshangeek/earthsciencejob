datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Job {
  id          Int      @id @default(autoincrement())
  title       String
  company     String
  location    String
  category    String   
  jobType     String   
  url         String   
  createdAt   DateTime @default(now())
}

